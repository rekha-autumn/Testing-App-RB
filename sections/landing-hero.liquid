<div class="landing-page-body">
<div class="landing-page-main">
  <section class="hero-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="hero-glow" style="background: radial-gradient(circle at center, {{ section.settings.glow_color }}, transparent 70%);"></div>
    <div class="hero-content">
      <h1 class="hero-title" style="color: {{ section.settings.title_color }};">
        {{ section.settings.title }}
      </h1>
      <p class="hero-subtitle" style="color: {{ section.settings.subtitle_color }};">
        {{ section.settings.subtitle }}
      </p>
      
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="btn-primary" style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }};">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
    
    {% if section.settings.image != blank %}
      <div class="hero-image-wrapper">
        {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero-image' }}
        
        {% if section.settings.discount_badge != blank %}
          <div class="badge-discount" style="background-color: {{ section.settings.badge_bg_color }}; color: {{ section.settings.badge_text_color }};">
            {{ section.settings.discount_badge }}
          </div>
        {% endif %}
      </div>
    {% else %}
      <!-- Fallback Image for preview -->
      <div class="hero-image-wrapper">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-image' }}
        <div class="badge-discount" style="background-color: {{ section.settings.badge_bg_color }}; color: {{ section.settings.badge_text_color }};">
          {{ section.settings.discount_badge }}
        </div>
      </div>
    {% endif %}
  </section>
</div>
</div>

{% schema %}
{
  "name": "Landing Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "AUGUST 15th SALE: UP TO 70% OFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading Color",
      "default": "#ffb4aa"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "24 Hours Only. Grab your favorites before they're gone."
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subheading Color",
      "default": "#e7bdb7"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP THE SALE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#ff3b30"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "discount_badge",
      "label": "Discount Badge Text",
      "default": "-70%"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge Background",
      "default": "#ff3b30"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Background Glow Color",
      "default": "#ff3b30"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Landing Hero"
    }
  ]
}
{% endschema %}
