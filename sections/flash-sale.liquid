<script>
        // Micro-interaction: Countdown Timer update
        const updateTimer = () => {
            const timerElement = document.getElementById('countdown-header');
            if (!timerElement) return;
            
            let currentText = timerElement.innerText;
            let timePart = currentText.split(': ').slice(1).join(': ');
            if (!timePart) return;

            let [h, m, s] = timePart.split(':').map(Number);
            
            s--;
            if (s < 0) { s = 59; m--; }
            if (m < 0) { m = 59; h--; }
            if (h < 0) { h = 0; m = 0; s = 0; }
            
            const format = (n) => n.toString().padStart(2, '0');
            timerElement.innerText = `15th AUG SPECIAL: ${format(h)}:${format(m)}:${format(s)}`;
        };
        setInterval(updateTimer, 1000);

        // Micro-interaction: Active scale on buttons
        document.querySelectorAll('button, a').forEach(el => {
            el.addEventListener('mousedown', () => el.style.transform = 'scale(0.95)');
            el.addEventListener('mouseup', () => el.style.transform = 'scale(1)');
            el.addEventListener('mouseleave', () => el.style.transform = 'scale(1)');
        });
    </script>

