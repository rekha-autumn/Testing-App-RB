<div class="landing-page-body">
<section class="trust-section" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="trust-grid">
    {% for block in section.blocks %}
      <div class="trust-item" {{ block.shopify_attributes }}>
        <div class="trust-icon-circle" style="background-color: {{ section.settings.icon_bg_color }}; color: {{ section.settings.icon_color }};">
          <span class="material-symbols-outlined">{{ block.settings.icon_name }}</span>
        </div>
        <div>
          <h4 class="trust-title" style="color: {{ section.settings.title_color }};">{{ block.settings.title }}</h4>
          <p class="trust-desc" style="color: {{ section.settings.text_color }};">{{ block.settings.text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Landing Trust Section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1c1b1b"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Background Color",
      "default": "#201f1f"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#ffb4aa"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#e5e2e1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#e7bdb7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon_name",
          "label": "Material Icon Name",
          "default": "local_shipping",
          "info": "Find icons at fonts.google.com/icons"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Fast Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "24-hour dispatch on all orders"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Trust Section",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "icon_name": "local_shipping",
            "title": "Fast Shipping",
            "text": "24-hour dispatch on all orders"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon_name": "verified_user",
            "title": "Secure Payment",
            "text": "SSL encryption for safe checkout"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon_name": "assignment_return",
            "title": "Easy Returns",
            "text": "30-day no questions asked policy"
          }
        }
      ]
    }
  ]
}
{% endschema %}
